{
    "target": "esp32s3",
    "builds": [
        {
            "name": "xiaozhi-ai-iot-vietnam-es3n28p-lcd-2.8",
            "sdkconfig_append": [
                "ES3N28P_LCD_ILI9341_240X320=y",
                "CONFIG_SD_CARD_MMC_INTERFACE=y",
                "CONFIG_FATFS_LFN_HEAP=y",
                "CONFIG_FATFS_API_ENCODING_UTF_8=y",
                "CONFIG_FATFS_FS_LOCK=5",
                "CONFIG_FLASH_CUSTOM_ASSETS=y",
                "CONFIG_CUSTOM_ASSETS_FILE=\"https://xiaozhi-ai-iot.vn/api/v1/ota/assets/default.bin\"",
                "CONFIG_RECEIVE_CUSTOM_MESSAGE=y",
                "CONFIG_WEATHER_IDLE_DISPLAY_ENABLE=y",
                "CONFIG_TOUCH_PANEL_ENABLE=y",
                "CONFIG_SD_CARD_ENABLE=y"
            ]
        }
    ]
}